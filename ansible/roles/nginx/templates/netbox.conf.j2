{% if nginx.redirect_http_to_https %}
server {
    listen 80;
    listen [::]:80;
    server_name {{ server.fqdn }} {{ server.hostname }} {{ expected_network.ip_address }};
    return 301 https://$host$request_uri;
}
{% endif %}

server {
    listen 443 ssl http2;
    listen [::]:443 ssl http2;
    server_name {{ server.fqdn }} {{ server.hostname }} {{ expected_network.ip_address }};

    ssl_certificate {{ tls.certificate }};
    ssl_certificate_key {{ tls.private_key }};
{% if tls.ca_chain %}
    ssl_trusted_certificate {{ tls.ca_chain }};
{% endif %}
    ssl_protocols TLSv1.2 TLSv1.3;
    ssl_session_cache shared:SSL:10m;
    ssl_session_timeout 1d;
    ssl_session_tickets off;

    client_max_body_size 25m;

    location /static/ {
        alias /var/www/netbox/static/;
        expires 7d;
        add_header Cache-Control "public";
    }

    location /media/ {
        alias /var/lib/netbox/media/;
    }

    location / {
        proxy_pass http://127.0.0.1:8001;
        proxy_set_header Host $host;
        proxy_set_header X-Real-IP $remote_addr;
        proxy_set_header X-Forwarded-For $proxy_add_x_forwarded_for;
        proxy_set_header X-Forwarded-Proto https;
        proxy_read_timeout 120s;
        proxy_connect_timeout 10s;
    }
}

