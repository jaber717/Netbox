platform:
  version: 1.0.0-rc1

deployment:
  environment: production
  installation_mode: connected

server:
  hostname: __HOSTNAME__
  fqdn: __FQDN__
  primary_ip: __PRIMARY_IP__
  timezone: UTC

packages:
  source: connected

netbox:
  version: 4.6.9
  source_sha256: b0c4431a0edc7ce7b019e3f339e944400bf8e628cefa92260a4784f218a67f7c
  admin_username: admin
  allowed_hosts:
    - __FQDN__
    - __HOSTNAME__
    - __PRIMARY_IP__
  csrf_trusted_origins:
    - https://__FQDN__
    - https://__PRIMARY_IP__

postgresql:
  version: "16"
  database: netbox
  username: netbox

redis:
  version: "6.2"
  bind: 127.0.0.1

nginx:
  stream: "1.24"
  redirect_http_to_https: true

tls:
  mode: self_signed
  certificate: /etc/pki/tls/certs/netbox.crt
  private_key: /etc/pki/tls/private/netbox.key
  ca_chain: ""

backup:
  local_path: /var/backups/netbox
  retention_days: 14
  offbox_target: ""

features:
  generic_foundation: false
  environment_validators: false
  ipam_audit_report: true
  ipam_allocation_request: false
  subnet_map: true
  cmdb: false
